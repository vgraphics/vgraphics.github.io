# vgraphics.gr on Hostinger (LiteSpeed, behind Hostinger's CDN). It does what GitHub Pages did for the site, and
# hardens it (George, 7 Nov 2026: "Dont forget to do any security improvements to our new server hosting.").
# The Deployer checks these rules live after every upload (its src/integrations/hostinger.ts) and rolls a release
# back when one fails; tools/check-site.mjs fails when this file loses one (tools/lib/htaccess.mjs).

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
AddDefaultCharset utf-8

RewriteEngine On

# One address for the site, in one hop (Search Console, 12 Nov 2026: two 301s for http://www.). www goes straight to
# https:// on the bare domain, whatever the scheme, so it comes first; the certificate's HTTP challenges stay where they are.
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L,NE]

# HTTPS. The CDN redirects at its edge too; X-Forwarded-Proto keeps this rule from looping behind it, and the
# certificate's HTTP challenges stay on HTTP.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,NE]

# The old WordPress site's addresses, which Google still asks for (Search Console, Oct and Nov 2026): one 301 each to the
# page that took its place (/index.php itself, its categories and feeds: the home page). They come before the "no PHP"
# rule below, which would answer 403. QSD drops the old query (?p=12, ?feed=rss2), which would otherwise land after the
# #contact fragment.
RewriteRule ^index\.php/contact(/|/index\.html)?$ https://vgraphics.gr/#contact [R=301,L,NE,QSD]
RewriteRule ^index\.php/about(-2)?(/|/index\.html)?$ https://vgraphics.gr/company/ [R=301,L,QSD]
RewriteRule ^index\.php(/.*)?$ https://vgraphics.gr/ [R=301,L,QSD]

# Two old picture addresses of Speedometer's key art, without an extension, that Google keeps retrying: to the pictures.
RewriteRule ^speedometer-wallpaper/img/key-art$ https://vgraphics.gr/speedometer-wallpaper/img/key-art-1920.jpg [R=301,L]
RewriteRule ^speedometer-wallpaper/img/key-art-tall$ https://vgraphics.gr/speedometer-wallpaper/img/key-art-tall-1080.jpg [R=301,L]

# Never served: dotfiles (but /.well-known/), the site's own tools, and source or secret files. The site is static, so
# no PHP either (the old WordPress addresses under /index.php are redirected above).
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteRule (^|/)\. - [F]
RewriteRule ^tools(/|$) - [F]
RewriteRule \.(md|py|pyc|sh|ps1|bat|cmd|ts|tsx|map|env|ini|cfg|conf|log|bak|old|orig|swp|sql|sqlite|db|pem|key|crt|csr|p12|pfx|jks|keystore|php\d?|phtml|phar)$ - [NC,F]

# Unity's pre-compressed files are sent as they are: never compressed a second time.
RewriteRule \.(br|gz)$ - [E=no-gzip:1,E=no-brotli:1]

# Map tiles: the browser's CORS preflight for a Range request.
RewriteCond %{REQUEST_METHOD} =OPTIONS
RewriteRule \.pmtiles$ - [R=204,L]

# Versioned pictures (README "Hosting", tools/lib/image-version.mjs): a page names a picture as name.<hash>.ext, the first
# 8 hex digits of the file's SHA-256, so its address changes with the picture and the browser keeps it a year. The file
# keeps its name: name.<hash>.ext is served from name.ext (a file that really has such a name is served as it is). The
# hash isn't checked here: check-site fails a page that names a stale one. The rewrite also marks the request, for the
# year-long Cache-Control below.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.+)\.[0-9a-f]{8}\.(avif|webp|jpe?g|png|gif|svg|ico)$ $1.$2 [NC,E=VERSIONED_IMAGE:1,L]

# Addresses without .html, as on GitHub Pages: /x serves x.html (before a folder of the same name), /dir goes to /dir/.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*[^/])$ $1.html [L]
# A folder with no page of its own (/assets/startup/, /party-doors/) is not found: a plain 404, never the 403 of
# Options -Indexes. Only folders: every file inside them (a Unity build's) is served as before.
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html !-f
RewriteRule ^ - [R=404,L]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(.*[^/])$ https://%{HTTP_HOST}/$1/ [R=301,L,NE]

# Security headers, on every answer.
Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
# Geolocation: the Speedometer try page reads GPS speed. Fullscreen: the Unity games and the try pages. The Unity
# frameworks carry motion, camera and microphone code, but no game or page uses them.
Header always set Permissions-Policy "geolocation=(self), fullscreen=(self), camera=(), microphone=(), accelerometer=(), gyroscope=(), magnetometer=()"
# Only our own pages may frame ours (the Palermo pages frame /vg--palermo-play/).
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Content-Security-Policy "frame-ancestors 'self'"
Header always unset X-Powered-By
Header unset X-Powered-By
# Any site may read our public files, as GitHub Pages allowed (nothing here uses cookies).
Header set Access-Control-Allow-Origin "*"

# Page pieces, not pages: the bits of HTML a page's script fetches (a ranking, an invite card, the Speedometer market's
# blocks) or a build sets into its page (the intro demos). Served bare, with no title, header or text around them, they
# read as empty pages, so search engines are told to leave them out (AdSense "Low-value content", 12 Nov 2026). Every
# piece is named here, with or without .html: check-site fails when a served HTML file without <html> isn't
# (tools/lib/htaccess.mjs).
SetEnvIfNoCase Request_URI "^/(exitwise/(challenge/challenge|demo/board|ranking/ranking|room/room)|palermo/map/viewer|speedometer-wallpaper/(creators/creator|demo/gauge|l/layout|layouts/browse|look/look|market-chapter|styles/made-with))(\.html)?$" PAGE_PIECE=1
Header set X-Robots-Tag "noindex" env=PAGE_PIECE

# Types. Scripts as text/javascript: LiteSpeed's own type for .js is application/x-javascript.
<IfModule mod_mime.c>
  AddType text/javascript .js .mjs
  AddType application/wasm .wasm
  AddType application/octet-stream .unityweb .data .pmtiles
  AddType application/manifest+json .webmanifest
  AddCharset utf-8 .js .mjs .css .json .svg .xml .txt .tsv .webmanifest
</IfModule>

# Unity builds without decompression fallback: .br and .gz files the browser unpacks itself. (Today's builds are
# .unityweb, decompressed by Unity's loader, and served as plain files.)
<FilesMatch "\.br$">
  Header set Content-Encoding br
  Header append Vary Accept-Encoding
</FilesMatch>
<FilesMatch "\.gz$">
  Header set Content-Encoding gzip
  Header append Vary Accept-Encoding
</FilesMatch>
<FilesMatch "\.wasm\.(br|gz)$">
  ForceType application/wasm
</FilesMatch>
<FilesMatch "\.js\.(br|gz)$">
  ForceType application/javascript
</FilesMatch>
<FilesMatch "\.(data|symbols\.json)\.(br|gz)$">
  ForceType application/octet-stream
</FilesMatch>

# Text is compressed (LiteSpeed and the CDN do it by themselves; these lines are for Apache).
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml text/tab-separated-values text/javascript application/javascript application/json application/xml application/manifest+json image/svg+xml
</IfModule>
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/xml text/tab-separated-values text/javascript application/javascript application/json application/xml application/manifest+json image/svg+xml
</IfModule>

# Caching. Every value says no-transform: without it Hostinger's CDN re-encodes images (JPEGs grow, WebP is sent to
# browsers that take it, and the art's XMP rights are stripped) and minifies text, so files stop being what the repo
# holds. Anything not named below: ten minutes, as GitHub Pages served everything.
Header set Cache-Control "public, max-age=600, no-transform"
# Pages and data revalidate on every visit (a 304 when nothing changed).
<FilesMatch "\.(html|json|txt|xml|tsv|webmanifest)$">
  Header set Cache-Control "no-cache, no-transform"
</FilesMatch>
# Unity builds keep their file names from release to release, so they revalidate too.
<FilesMatch "(\.(unityweb|wasm|br|gz)|\.loader\.js)$">
  Header set Cache-Control "no-cache, no-transform"
</FilesMatch>
# A content hash in the name never changes: name.1a2b3c4d.ext (the Palermo media), 658820f72b4617efb380.wasm. (Vite's
# index-B3Jhu0yD.js names can't be told from a hand-named menu-vertical.js by name alone: they keep the ten minutes.)
<FilesMatch "(\.[0-9a-f]{8,}|^[0-9a-f]{16,})\.[A-Za-z0-9]+$">
  Header set Cache-Control "public, max-age=31536000, immutable, no-transform"
</FilesMatch>
# A versioned picture's address names its content (the rewrite above): a year, immutable. Its file is name.ext, which the
# FilesMatch above doesn't see, so the request is marked instead: by the rewrite (Apache renames its variable
# REDIRECT_VERSIONED_IMAGE after an internal redirect) and by SetEnvIf, from the address asked for. Each mark is gated on
# the versioned address, so an unversioned picture never gets the year: if none of them takes, a versioned one keeps the
# ten minutes.
SetEnvIfNoCase Request_URI "\.[0-9a-f]{8}\.(avif|webp|jpe?g|png|gif|svg|ico)$" VERSIONED_IMAGE=1
Header set Cache-Control "public, max-age=31536000, immutable, no-transform" env=VERSIONED_IMAGE
Header set Cache-Control "public, max-age=31536000, immutable, no-transform" env=REDIRECT_VERSIONED_IMAGE
# Map tiles (/tiles/, one versioned .pmtiles file per map): long cache, Range requests, read by our own pages only.
# Plain "set", as the "*" above is: the same header in Apache's two tables would be sent twice.
<FilesMatch "\.pmtiles$">
  Header set Cache-Control "public, max-age=31536000, immutable, no-transform"
  Header set Access-Control-Allow-Origin "https://vgraphics.gr"
  Header set Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
  Header set Access-Control-Allow-Headers "Range"
  Header set Access-Control-Expose-Headers "Content-Range, Content-Length, ETag"
  Header set Access-Control-Max-Age "86400"
</FilesMatch>
